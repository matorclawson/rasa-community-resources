// Draft by rasa-ops, Nov 1, 2026, for the Nov 3 workshop. First real run is rasa-bench's. Nothing here has been run in a codespace.
{
  "name": "Rasa Studio and Mantle workshop (draft)",
  // The python image carries a Yarn apt source whose signing key fails apt update (NO_PUBKEY 62D54FD4003F6525), which
  // broke the docker-in-docker feature in rasa-bench's cold4 run. The base image has no Yarn source (not yet confirmed
  // by a run), and Python comes from the python feature. Package signature checks stay on.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "forwardPorts": [8080, 8081, 4000, 8000],
  "portsAttributes": {
    "8080": { "label": "Studio" },
    "8081": { "label": "Studio login (Keycloak)" },
    "4000": { "label": "Studio API" },
    "8000": { "label": "Model service" }
  },
  "secrets": {
    "RASA_LICENSE": { "description": "Your Rasa Developer Edition licence key" },
    "OPENAI_API_KEY": { "description": "Your OpenAI API key" }
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/workshops/software-factories-masterclass",
  "postCreateCommand": "bash \"$(git rev-parse --show-toplevel)/.devcontainer/software-factories-workshop/setup.sh\""
}
